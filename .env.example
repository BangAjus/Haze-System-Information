# Copy to .env and fill in. Never commit .env.

# Warehouse (Postgres). Inside Docker the host is "postgres"; from your Mac it is "localhost".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=haze
POSTGRES_PASSWORD=change-me
POSTGRES_DB=haze

# Kaggle API token: put kaggle.json in ~/.kaggle/ (kaggle.com > Settings > API > Create New Token).
# Docker mounts that folder read-only, so the token never goes in this file.
KAGGLE_DATASET=xjoannax88/global-weather-and-air-pollution-dataset
KAGGLE_FILE=output/openweather_weather_airpollution_top3cities_per_country.parquet

# Where raw downloads are kept
HAZE_DATA_DIR=./data

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# Dagster UI, used for "Open in Dagster" links in the API responses
DAGSTER_UI_URL=http://localhost:3000

# API
API_ADMIN_KEY=change-me-too

# Ports on your Mac for the Docker stack. Change any that clash with other apps.
POSTGRES_HOST_PORT=5432
MLFLOW_HOST_PORT=5001
DAGSTER_HOST_PORT=3000
API_HOST_PORT=8000
